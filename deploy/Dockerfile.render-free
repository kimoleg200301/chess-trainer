# syntax=docker/dockerfile:1
# One Render Free web instance; source frontend/backend remain separate projects.
FROM node:22-bookworm-slim AS web-build
WORKDIR /web-build
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca,required=false \
    if [ -f /run/secrets/proxy_ca ]; then \
      NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca npm ci --strict-ssl=true; \
    else npm ci --strict-ssl=true; fi
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends stockfish ca-certificates && rm -rf /var/lib/apt/lists/*
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=secret,id=proxy_ca,required=false \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir uv==0.12.23 && uv sync --frozen --no-dev
COPY backend/app ./app
COPY backend/alembic.ini ./
COPY backend/migrations ./migrations
COPY backend/start.sh ./start.sh
COPY data/puzzles.csv ./data/puzzles.csv
COPY --from=web-build /web-build/dist ./web
ENV DATA_PATH=/app/data/puzzles.csv STOCKFISH_PATH=/usr/games/stockfish FRONTEND_DIST=/app/web PORT=10000
RUN useradd --create-home --uid 10001 app && chmod +x /app/start.sh && chown -R app:app /app
USER app
EXPOSE 10000
CMD ["/app/start.sh"]
