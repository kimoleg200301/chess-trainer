# Template for a NEW local development database only.
# Generate local passwords with: python3 scripts/configure.py
# Existing WireGuard server: preserve its .env and compose.wireguard.yml;
# do not copy this template or run configure/bootstrap there. See deploy/SERVER.md.
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_CONFIGURE
AUTH_USERNAME=trainer
AUTH_PASSWORD=CHANGE_ME_GENERATE_WITH_CONFIGURE
APP_PORT=8080
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# For compose.vps.yml: DNS A/AAAA must point to your server.
APP_DOMAIN=
